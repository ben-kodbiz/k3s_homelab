#cloud-config
# K3s server node: base OS prep + K3s install with disabled defaults.
# K3s uses Flannel by default — we disable it for Cilium.
# Traefik and ServiceLB are also disabled.
hostname: ${hostname}
fqdn: ${fqdn}
create_hostname_file: true
manage_etc_hosts: true

package_update: true
package_upgrade: false
packages:
  - openssh-server
  - jq
  - curl
  - socat
  - conntrack
  - net-tools
  - htop
  - chrony
  - gnupg

ssh_pwauth: true
disable_root: false
password: ${vm_password}
chpasswd:
  expire: false
ssh_authorized_keys:
%{ for key in ssh_pubkeys ~}  - ${key}
%{ endfor ~}

write_files:
  - path: /etc/modules-load.d/k8s.conf
    content: |
      overlay
      br_netfilter
  - path: /etc/sysctl.d/99-k8s.conf
    content: |
      net.bridge.bridge-nf-call-iptables  = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward                 = 1
  - path: /etc/k3s-lab/env
    permissions: "0644"
    content: |
      K3S_VERSION=${k3s_version}
      CLUSTER_TOKEN=${cluster_token}
      API_VIP=${api_vip}
      NODE_IP=${node_ip}
      ROLE=${role}
      CLUSTER_CIDR=${cluster_cidr}
      SERVICE_CIDR=${service_cidr}
      TLS_SAN=${tls_san}
      SERVER_COUNT=${server_count}
      CLUSTER_NAME=${cluster_name}
      IS_FIRST_SERVER=${is_first_server}
      SERVER_URL=${server_url}

runcmd:
  - systemctl enable --now ssh
  - systemctl enable --now chrony
  - modprobe overlay
  - modprobe br_netfilter
  - sysctl --system
  - swapoff -a
  - sed -ri '/\sswap\s/d' /etc/fstab || true
  - |
%{ if is_first_server ~}
    # First server: initialize cluster with embedded etcd
    curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" sh -s - server \
      --cluster-init \
      --flannel-backend=none \
      --disable-network-policy \
      --disable=traefik \
      --disable=servicelb \
      --disable=local-storage \
      --tls-san="${api_vip}" \
      --tls-san="${node_ip}" \
      --tls-san="${fqdn}" \
      --write-kubeconfig-mode=0644 \
      --node-ip="${node_ip}" \
      --advertise-address="${node_ip}" \
      --cluster-cidr="${cluster_cidr}" \
      --service-cidr="${service_cidr}" \
      --token="${cluster_token}"
%{ else ~}
    # Joining server: connect to first server
    curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" sh -s - server \
      --server="${server_url}" \
      --flannel-backend=none \
      --disable-network-policy \
      --disable=traefik \
      --disable=servicelb \
      --disable=local-storage \
      --tls-san="${api_vip}" \
      --tls-san="${node_ip}" \
      --tls-san="${fqdn}" \
      --write-kubeconfig-mode=0644 \
      --node-ip="${node_ip}" \
      --advertise-address="${node_ip}" \
      --cluster-cidr="${cluster_cidr}" \
      --service-cidr="${service_cidr}" \
      --token="${cluster_token}"
%{ endif ~}
  - |
    # Wait for K3s to be ready
    until k3s kubectl get nodes 2>/dev/null | grep -q "Ready"; do
      echo "Waiting for K3s to start..."
      sleep 5
    done
    echo "K3s server node ready"
